# IDE config
HOSTNAME={{ hostname }}
HTTP_PORT={{ http_port }}
HTTPS_PORT={{ https_port }}
SSL_ENABLED={{ ssl_enabled }}
# must be located in ./certs, defaults to "<hostname>.pem"
SSL_CERT_FILE={{ ssl_cert_file }}
# must be located in ./certs, defaults to "<hostname>.key"
SSL_KEY_FILE={{ ssl_key_file }}

INITIAL_ROOT_PASSWORD={{ initial_root_password }}
INITIAL_ROOT_MAIL={{ initial_root_mail }}
# can be used to create a global runtime with given token
INITIAL_RUNTIME_TOKEN={{ initial_runtime_token }}

# Runtime config
AQUILA_LOG_LEVEL={{ aquila_log_level }}
AQUILA_NATS_URL={{ aquila_nats_url }}
AQUILA_NATS_BUCKET={{ aquila_nats_bucket }}
AQUILA_BACKEND_URL={{ aquila_backend_url }}
AQUILA_BACKEND_TOKEN={{ aquila_backend_token }}
AQUILA_BACKEND_UNARY_TIMEOUT_SECS={{ aquila_backend_unary_timeout_secs }}
AQUILA_GRPC_HOST={{ aquila_grpc_host }}
AQUILA_GRPC_PORT={{ aquila_grpc_port }}
AQUILA_GRPC_HEALTH_SERVICE={{ aquila_grpc_health_service }}
DRACO_REST_PORT={{ draco_rest_port }}
DRACO_REST_HOST={{ draco_rest_host }}

TAURUS_AQUILA_TOKEN={{ taurus_aquila_token }}
DRACO_REST_AQUILA_TOKEN={{ draco_rest_aquila_token }}
DRACO_CRON_AQUILA_TOKEN={{ draco_cron_aquila_token }}

AQUILA_GRPC_CONNECT_TIMEOUT_SECS={{ aquila_grpc_connect_timeout_secs }}
AQUILA_GRPC_REQUEST_TIMEOUT_SECS={{ aquila_grpc_request_timeout_secs }}

# Active services
# Available services: ide, runtime, ide_velorum (AI orchestrator)
COMPOSE_PROFILES={{ compose_profiles }}

# Image config
IMAGE_REGISTRY={{ image_registry }}
IMAGE_TAG={{ image_tag }}
# ce or ee
IMAGE_EDITION={{ image_edition }}

# Sagittarius config
# change these to new secret values
SAGITTARIUS_DB_ENCRYPTION_PRIMARY_KEY={{ sagittarius_db_encryption_primary_key }}
SAGITTARIUS_DB_ENCRYPTION_DETERMINISTIC_KEY={{ sagittarius_db_encryption_deterministic_key }}
SAGITTARIUS_DB_ENCRYPTION_KEY_DERIVATION_SALT={{ sagittarius_db_encryption_key_derivation_salt }}
SAGITTARIUS_RAILS_SECRET_KEY_BASE={{ sagittarius_rails_secret_key_base }}

# Velorum config
# VELORUM_ENABLED=false (override, default checks if COMPOSE_PROFILES contains ide_velorum)
VELORUM_HOST={{ velorum_host }}
VELORUM_PORT={{ velorum_port }}
# change to a random value
VELORUM_JWT_SECRET={{ velorum_jwt_secret }}

# example, GPT5 in the variable name can be changed to other values. This set of variables can be repeated multiple times
# VELORUM_MODEL_GPT5_IDENTIFIER=gpt-5
# VELORUM_MODEL_GPT5_NAME='GPT 5'
# VELORUM_MODEL_GPT5_CAPABILITIES=explain,generate
# if using a non-default base-url
# VELORUM_MODEL_GPT5_API=
# or openrouter/openai/gpt-5, etc depending on the provider
# VELORUM_MODEL_GPT5_PROVIDER=openai/gpt-5
# authentication token
# VELORUM_MODEL_GPT5_AUTH=your-secret-token
# token cost multiplier for this model
# VELORUM_MODEL_GPT5_TOKEN_COST=1

# OpenTelemetry
OPENTELEMETRY_ENABLED={{ opentelemetry_enabled }}
OPENTELEMETRY_GRPC_HOST={{ opentelemetry_grpc_host }}
OPENTELEMETRY_LOGS_HTTP_ENDPOINT={{ opentelemetry_logs_http_endpoint }}
OPENTELEMETRY_METRICS_HTTP_ENDPOINT={{ opentelemetry_metrics_http_endpoint }}
OPENTELEMETRY_TRACES_HTTP_ENDPOINT={{ opentelemetry_traces_http_endpoint }}

# OPENTELEMETRY_SERVICE_NAME_SAGITTARIUS_WEB=sagittarius-web
# OPENTELEMETRY_SERVICE_NAME_SAGITTARIUS_CABLE=sagittarius-cable
# OPENTELEMETRY_SERVICE_NAME_SAGITTARIUS_GRPC=sagittarius-grpc
# OPENTELEMETRY_SERVICE_NAME_SAGITTARIUS_BACKGROUND=sagittarius-background

# Internal config options
SAGITTARIUS_RAILS_HOST={{ sagittarius_rails_host }}
SAGITTARIUS_RAILS_PORT={{ sagittarius_rails_port }}
SAGITTARIUS_CABLE_HOST={{ sagittarius_cable_host }}
SAGITTARIUS_CABLE_PORT={{ sagittarius_cable_port }}
SAGITTARIUS_GRPC_HOST={{ sagittarius_grpc_host }}
SAGITTARIUS_GRPC_PORT={{ sagittarius_grpc_port }}
SAGITTARIUS_LOG_LEVEL={{ sagittarius_log_level }}
# web threads and grpc threads must be lower than db pool size
SAGITTARIUS_RAILS_WEB_THREADS={{ sagittarius_rails_web_threads }}
SAGITTARIUS_RAILS_GRPC_THREADS={{ sagittarius_rails_grpc_threads }}
SAGITTARIUS_DB_POOL_SIZE={{ sagittarius_db_pool_size }}
SCULPTOR_HOST={{ sculptor_host }}
SCULPTOR_PORT={{ sculptor_port }}
POSTGRES_HOST={{ postgres_host }}
POSTGRES_PORT={{ postgres_port }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
